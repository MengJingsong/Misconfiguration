RULE diag 854
CLASS org.apache.cassandra.net.OutboundConnection$EventLoopDelivery
METHOD doRun
AT LINE 854
IF true
DO traceOpen("flw", "@TRACE@");
   traceln("flw", "D854 " + System.currentTimeMillis() + " " + Thread.currentThread().getName() + " f=" + $this.flushingBytes + " canon=" + $canonicalSize + " sending=" + $sendingBytes + " w=" + $this.isWritable + " H=" + $settings.flushHighWaterMark)
ENDRULE

