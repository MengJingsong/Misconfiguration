# Byteman observation rules for native_transport_receive_queue_capacity-acquireCapacity-queueCapacity (case 9c/9d,
# amended 2026-10-15). They change no behaviour. Server handlers only: every rule fires only when $0's class is exactly
# org.apache.cassandra.transport.CQLMessageHandler (SimpleClient's response handler is an anonymous subclass, and the
# internode InboundMessageHandler shares AbstractMessageHandler). Every line goes to the file named by -Dstage4.trace
# (default ntq.trace) and ends with ms=<epoch ms>:
#
#   new id=<channel id> throw=<throwOnOverload> cap=<queueCapacity> srv=<serverConnection != null> remote=<address>
#       exit of the CQLMessageHandler constructor: the read-back of the capacity and of the connection's mode.
#   acq id= b=<bytes> out=<Outcome> q=<queueSize after> cap= ep=<using>/<limit> gl=<using>/<limit>
#       exit of AbstractMessageHandler.acquireCapacity(Limit, Limit, int), the method holding the check (:419). On a
#       reactivation one of the two reserves is the wait queue's lease (a Basic limit), not the configured reserve.
#   rel id= b= q=<queueSize after the decrement>
#       in releaseCapacity(int) right after queueSizeUpdater.getAndAdd(this, -bytes), before the reserves are released.
#   dec id= b=<bodySizeInBytes> bp=<Overload>
#       entry of CQLMessageHandler.processRequest(Envelope, Overload): the request is about to be decoded (both paths:
#       processRequestAndUpdateMetrics for one-frame requests, LargeMessage.onComplete for multi-frame ones).
#   rls id= b=
#       entry of CQLMessageHandler.release(Envelope.Header): a decoded request's capacity is given back (after its
#       response is flushed, or after a decode error).
#   disc id= b= ov=<Overload>     entry of discardAndThrow (one-frame request refused in the throwing mode)
#   ldisc id= b=                  a multi-frame request marked overloaded in processFirstFrameOfLargeMessage
#   wake id= ns=<waited ns>       entry of onReserveCapacityRegained: a wait-queue ticket fired for this handler

RULE ntq new handler
CLASS org.apache.cassandra.transport.CQLMessageHandler
METHOD <init>
AT EXIT
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "new id=" + $0.id() + " throw=" + $0.throwOnOverload + " cap=" + $0.queueCapacity
                  + " srv=" + ($0.serverConnection != null) + " remote=" + $0.channel.remoteAddress()
                  + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq acquire exit
CLASS org.apache.cassandra.net.AbstractMessageHandler
METHOD acquireCapacity(org.apache.cassandra.net.ResourceLimits$Limit, org.apache.cassandra.net.ResourceLimits$Limit, int)
AT EXIT
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "acq id=" + $0.id() + " b=" + $3 + " out=" + $! + " q=" + $0.queueSize + " cap=" + $0.queueCapacity
                  + " ep=" + $1.using() + "/" + $1.limit() + " gl=" + $2.using() + "/" + $2.limit()
                  + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq release decrement
CLASS org.apache.cassandra.net.AbstractMessageHandler
METHOD releaseCapacity(int)
AFTER INVOKE java.util.concurrent.atomic.AtomicLongFieldUpdater.getAndAdd
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "rel id=" + $0.id() + " b=" + $1 + " q=" + ($! - $1) + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq decode
CLASS org.apache.cassandra.transport.CQLMessageHandler
METHOD processRequest(org.apache.cassandra.transport.Envelope, org.apache.cassandra.transport.ClientResourceLimits$Overload)
AT ENTRY
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "dec id=" + $0.id() + " b=" + $1.header.bodySizeInBytes + " bp=" + $2
                  + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq release decoded
CLASS org.apache.cassandra.transport.CQLMessageHandler
METHOD release(org.apache.cassandra.transport.Envelope$Header)
AT ENTRY
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "rls id=" + $0.id() + " b=" + $1.bodySizeInBytes + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq discard small
CLASS org.apache.cassandra.transport.CQLMessageHandler
METHOD discardAndThrow
AT ENTRY
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "disc id=" + $0.id() + " b=" + $5 + " ov=" + $6 + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq discard large
CLASS org.apache.cassandra.transport.CQLMessageHandler
METHOD processFirstFrameOfLargeMessage
AFTER INVOKE markOverloaded
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "ldisc id=" + $0.id() + " b=" + $messageSize + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE ntq ticket fired
CLASS org.apache.cassandra.net.AbstractMessageHandler
METHOD onReserveCapacityRegained
AT ENTRY
IF $0.getClass().getName().equals("org.apache.cassandra.transport.CQLMessageHandler")
DO traceOpen("ntq", java.lang.System.getProperty("stage4.trace", "ntq.trace"));
   traceln("ntq", "wake id=" + $0.id() + " ns=" + $3 + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE
