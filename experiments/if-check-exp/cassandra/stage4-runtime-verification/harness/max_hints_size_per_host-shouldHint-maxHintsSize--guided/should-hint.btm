# Byteman observation rules for max_hints_size_per_host-shouldHint-maxHintsSize, case 9c/9d (amended 2026-10-14).
# They change no behaviour. Every line goes to the file named by -Dstage4.trace (default mhs.trace):
#
#   decide ep=<endpoint> result=<bool> checked=<T> limit=<L> ms=<epoch>
#       one per StorageProxy.shouldHint(Replica, boolean) call, at its exit. checked and limit are the values the check
#       itself used: captured right after its own HintsService.getTotalHintsSize() call (StorageProxy.java:2491), where
#       the local maxHintsSize is in scope. checked=-1 when that call was not made (the guard maxHintsSize > 0 at :2489
#       skipped it, or an earlier rejection returned first); limit is then read from DatabaseDescriptor at exit.
#   site send ep=<endpoint> result=<bool> key=<partition key, hex> ms=<epoch>
#       the verdict as read at the primary decision point, StorageProxy.sendToHintedReplicas() :1552, with the
#       mutation's key, so the loss read-back can be compared row by row.
#   flush host=<hostId> size=<position> ms=<epoch>
#       at the exit of HintsWriter.Session.close(): the moment the operand moves (HintsWriter.java:274); size is the
#       file's new length.
#   roll host=<hostId> ms=<epoch>
#       HintsStore.closeWriter() with an open writer: the file is closed and queued (a 128 MiB roll, or a dispatch).

RULE mhs decide clear
CLASS org.apache.cassandra.service.StorageProxy
METHOD shouldHint(org.apache.cassandra.locator.Replica, boolean)
AT ENTRY
IF true
DO unlink("mhs.T", java.lang.Thread.currentThread());
   unlink("mhs.L", java.lang.Thread.currentThread())
ENDRULE

RULE mhs decide operand
CLASS org.apache.cassandra.service.StorageProxy
METHOD shouldHint(org.apache.cassandra.locator.Replica, boolean)
AFTER INVOKE org.apache.cassandra.hints.HintsService.getTotalHintsSize
IF true
DO link("mhs.T", java.lang.Thread.currentThread(), "" + $!);
   link("mhs.L", java.lang.Thread.currentThread(), "" + $maxHintsSize)
ENDRULE

RULE mhs decide exit
CLASS org.apache.cassandra.service.StorageProxy
METHOD shouldHint(org.apache.cassandra.locator.Replica, boolean)
AT EXIT
IF true
DO traceOpen("mhs", java.lang.System.getProperty("stage4.trace", "mhs.trace"));
   traceln("mhs", "decide ep=" + $1.endpoint() + " result=" + $!
                  + " checked=" + (linked("mhs.T", java.lang.Thread.currentThread()) == null ? "-1" : linked("mhs.T", java.lang.Thread.currentThread()))
                  + " limit=" + (linked("mhs.L", java.lang.Thread.currentThread()) == null ? "" + org.apache.cassandra.config.DatabaseDescriptor.getMaxHintsSizePerHost() : linked("mhs.L", java.lang.Thread.currentThread()))
                  + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE mhs site send
CLASS org.apache.cassandra.service.StorageProxy
METHOD sendToHintedReplicas
AFTER INVOKE shouldHint(org.apache.cassandra.locator.Replica)
IF true
DO traceOpen("mhs", java.lang.System.getProperty("stage4.trace", "mhs.trace"));
   traceln("mhs", "site send ep=" + $destination.endpoint() + " result=" + $! + " key=" + org.apache.cassandra.utils.ByteBufferUtil.bytesToHex($1.key().getKey()) + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE mhs flush session close
CLASS org.apache.cassandra.hints.HintsWriter$Session
METHOD close
AT EXIT
IF true
DO traceOpen("mhs", java.lang.System.getProperty("stage4.trace", "mhs.trace"));
   traceln("mhs", "flush host=" + $0.this$0.descriptor.hostId + " size=" + $0.position() + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE

RULE mhs writer roll
CLASS org.apache.cassandra.hints.HintsStore
METHOD closeWriter
AT ENTRY
IF $0.hintsWriter != null
DO traceOpen("mhs", java.lang.System.getProperty("stage4.trace", "mhs.trace"));
   traceln("mhs", "roll host=" + $0.hostId + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE
