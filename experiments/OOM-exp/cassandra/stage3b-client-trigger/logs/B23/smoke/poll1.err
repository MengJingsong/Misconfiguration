MaxHintsInProgress=5120
mut_active <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=ActiveTasks
mut_pending <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=PendingTasks
mut_completed <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=CompletedTasks
ntr_active <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=ActiveTasks
ntr_pending <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=PendingTasks
ntr_completed <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=CompletedTasks
K <- org.apache.cassandra.metrics:type=Storage,name=TotalHintsInProgress
hints_total <- org.apache.cassandra.metrics:type=Storage,name=TotalHints
unavail <- org.apache.cassandra.metrics:type=ClientRequest,scope=Write,name=Unavailables
timeouts <- org.apache.cassandra.metrics:type=ClientRequest,scope=Write,name=Timeouts
failures <- org.apache.cassandra.metrics:type=ClientRequest,scope=Write,name=Failures
wr_done <- org.apache.cassandra.metrics:type=ClientRequest,scope=Write,name=Latency
dropped_mut <- org.apache.cassandra.metrics:type=DroppedMessage,scope=MUTATION_REQ,name=Dropped
dropped_hint <- org.apache.cassandra.metrics:type=DroppedMessage,scope=HINT_REQ,name=Dropped
