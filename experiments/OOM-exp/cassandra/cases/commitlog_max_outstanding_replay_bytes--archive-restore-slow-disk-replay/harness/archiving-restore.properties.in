# R23 restored node: archiving on, point-in-time restore from the archive (@PIT@ = PIT_T or PIT_C, GMT).
archive_command=/bin/ln %path /mydata/s4/r23/archive/%name
restore_command=/bin/cp -f %from %to
restore_directories=/mydata/s4/r23/archive
restore_point_in_time=@PIT@
snapshot_commitlog_position=
precision=MICROSECONDS
