MaxHintsInProgress=1024
K_rt <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=rt,name=MemtableOnHeapDataSize
sw_rt <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=rt,name=MemtableSwitchCount
wl_rt <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=rt,name=WriteLatency
K_blob <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=blob,name=MemtableOnHeapDataSize
sw_blob <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=blob,name=MemtableSwitchCount
wl_blob <- org.apache.cassandra.metrics:type=Table,keyspace=r22,scope=blob,name=WriteLatency
K_all <- org.apache.cassandra.metrics:type=Table,name=AllMemtablesOnHeapDataSize
active <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=ActiveTasks
pending <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=PendingTasks
completed <- org.apache.cassandra.metrics:type=ThreadPools,path=request,scope=MutationStage,name=CompletedTasks
ntr_active <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=ActiveTasks
ntr_pending <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=PendingTasks
ntr_completed <- org.apache.cassandra.metrics:type=ThreadPools,path=transport,scope=Native-Transport-Requests,name=CompletedTasks
hints_inprog <- org.apache.cassandra.metrics:type=Storage,name=TotalHintsInProgress
hints_total <- org.apache.cassandra.metrics:type=Storage,name=TotalHints
dropped_mut <- org.apache.cassandra.metrics:type=DroppedMessage,scope=MUTATION_REQ,name=Dropped
wr_timeouts <- org.apache.cassandra.metrics:type=ClientRequest,scope=Write,name=Timeouts
cl_size <- org.apache.cassandra.metrics:type=CommitLog,name=TotalCommitLogSize
