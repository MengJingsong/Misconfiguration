# R6-V DOB workload (from default run 1): one __SIZE__-byte blob per partition into the pre-created dobks.standard1 (dc1 only).
# No keyspace_definition/table_definition, so cassandra-stress issues no schema statement.
keyspace: dobks
table: standard1
columnspec:
  - name: key
    size: fixed(10)
    population: seq(1..1000000)
  - name: C0
    size: fixed(__SIZE__)
insert:
  partitions: fixed(1)
  batchtype: UNLOGGED
  select: fixed(1)/1
queries:
  read1:
    cql: select * from standard1 where key = ?
    fields: samerow
