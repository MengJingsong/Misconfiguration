RULE lister files
CLASS org.apache.cassandra.db.lifecycle.LogAwareFileLister
METHOD innerList
AT EXIT
IF $0.folder.toString().contains("/gen/out/")
DO traceOpen("d", "/mydata/jingsong-cass-s4/o117/logs/diag-trace2.txt"); traceln("d", "O117DIAG innerList " + $0.folder + " files=" + $0.files.size() + " ret=" + $!.size())
ENDRULE

RULE try component
CLASS org.apache.cassandra.io.sstable.SSTable
METHOD tryComponentFromFilename(org.apache.cassandra.io.util.File)
AT EXIT
IF $1.toString().contains("/gen/out/")
DO traceOpen("d", "/mydata/jingsong-cass-s4/o117/logs/diag-trace2.txt"); traceln("d", "O117DIAG tryComponent " + $1 + " -> " + $!)
ENDRULE

RULE fromFile throws
CLASS org.apache.cassandra.io.sstable.Descriptor
METHOD fromFileWithComponent(org.apache.cassandra.io.util.File, boolean)
AT EXCEPTION EXIT
IF $1.toString().contains("/gen/out/")
DO traceOpen("d", "/mydata/jingsong-cass-s4/o117/logs/diag-trace2.txt"); traceln("d", "O117DIAG fromFileWithComponent threw for " + $1); traceStack("O117DIAG ", "d")
ENDRULE

RULE filter predicate
CLASS org.apache.cassandra.db.Directories$SSTableLister
METHOD lambda$getFilter$*
AT ENTRY
IF $1.toString().contains("/gen/out/")
DO traceOpen("d", "/mydata/jingsong-cass-s4/o117/logs/diag-trace2.txt"); traceln("d", "O117DIAG predicate " + $1 + " " + $2)
ENDRULE
