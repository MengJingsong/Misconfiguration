# Byteman trigger for internode_application_receive_queue_capacity-releaseCapacity-queueCapacity--autonomous (case file
# B3a: "a rule delaying org.apache.cassandra.db.MutationVerbHandler.doVerb by 200 ms (AT ENTRY DO Thread.sleep(200))").
# Loaded on node B only. Copied from the closed sibling's hold-handler.btm (acquireCapacity--guided), renamed: while the
# file named by -Dstage4.hold.file exists, each MUTATION_REQ's verb handler sleeps -Dstage4.hold.ms (200) at its entry,
# so the MutationStage thread keeps the message's capacity (released only after the verb handler returns,
# InboundMessageHandler.java:427-442). Without the file the rule does nothing (control B3h(a), "Byteman off").
# One "hold" line per held call goes to the trace file of receive-trace.btm.

RULE rrc hold mutation verb handler
CLASS org.apache.cassandra.db.MutationVerbHandler
METHOD doVerb
AT ENTRY
IF (new java.io.File(java.lang.System.getProperty("stage4.hold.file", "/nonexistent-stage4-hold"))).exists()
DO java.lang.Thread.sleep(java.lang.Long.parseLong(java.lang.System.getProperty("stage4.hold.ms", "200")));
   traceOpen("rrc", java.lang.System.getProperty("stage4.trace", "rrc.trace"));
   traceln("rrc", "hold thread=" + java.lang.Thread.currentThread().getName() + " ms=" + java.lang.System.currentTimeMillis())
ENDRULE
